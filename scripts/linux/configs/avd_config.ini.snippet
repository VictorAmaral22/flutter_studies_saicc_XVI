# Trecho aplicado ao config.ini do AVD após criação.
# Valores pensados para lab (~8–16 GB RAM, CPU com virtualização).

hw.ramSize=1536
hw.heapSize=256
hw.cpu.ncore=2
hw.gpu.enabled=yes
hw.gpu.mode=host
hw.keyboard=yes
hw.mainKeys=no
hw.sdCard=no
disk.dataPartition.size=2048M
vm.heapSize=256
fastboot.forceColdBoot=no
fastboot.forceFastBoot=yes
showDeviceFrame=no
skin.dynamic=yes
